  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d567712e45d7574eb5990e175633c57, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneScript
  cutscenePanel: {fileID: 1963300977}
  artworkImage: {fileID: 775393104}
  dialogueText: {fileID: 415319688}
  panels:
  - artwork: {fileID: 6793557588129605565, guid: 85f7df328bc01ef4183a802678caa32f, type: 3}
    dialogue: Three days have passed since the funeral.
  - artwork: {fileID: 6793557588129605565, guid: 85f7df328bc01ef4183a802678caa32f, type: 3}
    dialogue: The familiar smell of old wood and dust greets me as I step inside.
      Rain taps softly against the windows, and the sound of ticking clocks fills
      the silence.
  - artwork: {fileID: 6793557588129605565, guid: 85f7df328bc01ef4183a802678caa32f, type: 3}
    dialogue: My eyes settle on a tall pine wall clock standing quietly among the
      others.
  - artwork: {fileID: 5432973371174461796, guid: e7d6d30b964c0474bbe1698995767882, type: 3}
    dialogue: ' Unlike the rest, its hands aren''t moving.'
  - artwork: {fileID: 5432973371174461796, guid: e7d6d30b964c0474bbe1698995767882, type: 3}
    dialogue: Strange...
  - artwork: {fileID: 6624625151918079273, guid: 60ebbba0e8d423d40a417ed72dfc97ba, type: 3}
    dialogue: ohh? A Letter.
  - artwork: {fileID: 6624625151918079273, guid: 60ebbba0e8d423d40a417ed72dfc97ba, type: 3}
    dialogue: It's from Lola.
  - artwork: {fileID: 6624625151918079273, guid: 60ebbba0e8d423d40a417ed72dfc97ba, type: 3}
    dialogue: "\"Nora \u2014 wind the clocks on Sundays. Don't let the damp get at
      the pendulum."
  - artwork: {fileID: 6624625151918079273, guid: 60ebbba0e8d423d40a417ed72dfc97ba, type: 3}
    dialogue: And answer the box, apo. It doesn't like to be ignored."
  typewriterDelay: 0.035
  fadeDuration: 0.5
  playAtStart: 1
  playOnlyOnce: 1
  cutsceneId: 0
  dialogueAfterCutscene: {fileID: 561470612}
  onCutsceneComplete:
    m_PersistentCalls:
      m_Calls:
